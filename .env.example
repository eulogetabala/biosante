# Clés de service Firebase (console Firebase → Paramètres du projet → Comptes de service).
# À recopier telles quelles dans Netlify, jamais dans le dépôt.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Clé privée sur une seule ligne, avec les retours écrits \n :
# "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Clé publique du projet (elle apparaît déjà dans le bundle du site).
# Sert uniquement à vérifier les mots de passe auprès de Firebase Authentication.
NEXT_PUBLIC_FIREBASE_API_KEY=

# Secret qui signe le cookie de session. 32 caractères minimum.
# Générer avec : openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Secret du webhook Netlify Forms (Netlify → Forms → Form notifications →
# Outgoing webhook → JWS secret). Sert à vérifier l'authenticité des soumissions
# reçues par /api/forms. Sans lui, la route refuse tout.
NETLIFY_FORMS_SECRET=

# Boîte qui reçoit les alertes de nouvelle demande. Configuré dans Netlify,
# pas ici : Forms → Form notifications → Email.
# ADMIN_NOTIFICATION_EMAIL=contact@grbiosante.com
